# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/

# Secrets / env
.env
.env.*

# Model weights & checkpoints (never commit large binaries)
checkpoints/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt

# Large / cached data
data/raw/
data/cache/
*.arrow

# HF / torch caches that may land locally
.cache/

# OS noise
Thumbs.db
.DS_Store

# Keep results (metrics, plots, sample outputs) tracked, but ignore stray large files there
results/**/*.bin
results/**/*.safetensors
